diff --git a/src/runtime/sys_aros_amd64.s b/src/runtime/sys_aros_amd64.s
new file mode 100644
index 00000000..70468892
--- /dev/null
+++ b/src/runtime/sys_aros_amd64.s
@@ -0,0 +1,12 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+#include "textflag.h"
+
+// On AROS the thread pointer is not something the runtime installs: the kernel
+// publishes the address of the running task's private word at %gs:0x18, and
+// get_tls reads it from there. So there is nothing for settls to set -- g is
+// stored straight into that word by the g(r) form. Same shape as Plan 9.
+TEXT runtime·settls(SB),NOSPLIT,$0
+	RET
