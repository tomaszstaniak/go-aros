@@ -0,0 +1,99 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build aros
+
+package poll
+
+import (
+	"errors"
+	"io"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"time"
+)
+
+// FD is a file descriptor. Same shape as Plan 9's: package os keeps the
+// descriptor itself and does its own I/O through syscall, so this exists for
+// the parts of os that speak poll (deadlines, raw access), all of which are
+// unsupported here.
+type FD struct {
+	// Lock sysfd and serialize access to Read and Write methods.
+	fdmu fdMutex
+
+	Destroy func()
+
+	// deadlines
+	rmu       sync.Mutex
+	wmu       sync.Mutex
+	rtimedout atomic.Bool
+	wtimedout atomic.Bool
+
+	// Whether this is a normal file.
+	isFile bool
+
+	// Whether this file has been set to blocking mode.
+	isBlocking uint32
+}
+
+func (fd *FD) destroy() error {
+	if fd.Destroy != nil {
+		fd.Destroy()
+	}
+	return nil
+}
+
+func (fd *FD) Close() error {
+	if !fd.fdmu.increfAndClose() {
+		return errClosing(fd.isFile)
+	}
+	return nil
+}
+
+func (fd *FD) Read(fn func([]byte) (int, error), b []byte) (int, error) {
+	if err := fd.readLock(); err != nil {
+		return 0, err
+	}
+	defer fd.readUnlock()
+	if len(b) == 0 {
+		return 0, nil
+	}
+	if fd.rtimedout.Load() {
+		return 0, ErrDeadlineExceeded
+	}
+	n, err := fn(b)
+	if n == 0 && err == nil && !fd.isFile {
+		err = io.EOF
+	}
+	return n, err
+}
+
+func (fd *FD) Write(fn func([]byte) (int, error), b []byte) (int, error) {
+	if err := fd.writeLock(); err != nil {
+		return 0, err
+	}
+	defer fd.writeUnlock()
+	if fd.wtimedout.Load() {
+		return 0, ErrDeadlineExceeded
+	}
+	return fn(b)
+}
+
+func (fd *FD) SetDeadline(t time.Time) error      { return errors.ErrUnsupported }
+func (fd *FD) SetReadDeadline(t time.Time) error  { return errors.ErrUnsupported }
+func (fd *FD) SetWriteDeadline(t time.Time) error { return errors.ErrUnsupported }
+
+func (fd *FD) ReadLock() error { return fd.readLock() }
+func (fd *FD) ReadUnlock()     { fd.readUnlock() }
+
+func IsPollDescriptor(fd uintptr) bool { return false }
+
+func (fd *FD) RawControl(f func(uintptr)) error   { return errors.New("not supported") }
+func (fd *FD) RawRead(f func(uintptr) bool) error  { return errors.New("not supported") }
+func (fd *FD) RawWrite(f func(uintptr) bool) error { return errors.New("not supported") }
+
+func DupCloseOnExec(fd int) (int, string, error) {
+	return -1, "dup", syscall.ENOSYS
+}
