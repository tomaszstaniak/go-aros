diff --git a/src/runtime/os_aros.go b/src/runtime/os_aros.go
new file mode 100644
index 00000000..c0109b86
--- /dev/null
+++ b/src/runtime/os_aros.go
@@ -0,0 +1,95 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build aros
+
+// AROS OS layer.
+//
+// Every function here is a stub with the correct signature and a throw. That
+// is deliberate and temporary: the point of this file, in this state, is to
+// let package runtime compile so a program can be *linked*, which is the only
+// way to find out whether -linkmode=external can hand an ET_REL executable to
+// x86_64-aros-gcc. Until that question is answered there is no sense writing
+// the real implementations, because a negative answer changes the shape of the
+// port. Each stub is then replaced by exec.library/dos.library calls.
+//
+// Nothing here runs. Do not read a throw as a design decision.
+
+package runtime
+
+import (
+	"internal/runtime/atomic"
+	"unsafe"
+)
+
+const arosStub = "aros: not implemented"
+
+// mOS is the per-M operating-system state. An M on AROS will be an Exec task;
+// waitsemacount is what lock_sema.go requires of every platform that parks on
+// a counting semaphore rather than a futex.
+type mOS struct {
+	waitsemacount uint32
+}
+
+type sigset struct{}
+
+type gsignalStack struct{}
+
+// AROS has no Unix signal numbering. The value only has to bound the tables in
+// sigqueue_aros.go.
+const _NSIG = 32
+
+//
+// Startup and environment
+//
+
+func osinit()                 { throw(arosStub) }
+func goenvs()                 { throw(arosStub) }
+func libpreinit()             {}
+func getCPUCount() int32      { return 1 }
+func readRandom(r []byte) int { return 0 }
+
+//
+// Threads. An M will map onto an Exec task created with CreateNewProc.
+//
+
+func newosproc(mp *m)                                { throw(arosStub) }
+func newosproc0(stacksize uintptr, fn unsafe.Pointer) { throw(arosStub) }
+func mpreinit(mp *m)                                 { throw(arosStub) }
+func minit()                                         { throw(arosStub) }
+func unminit()                                       { throw(arosStub) }
+func mdestroy(mp *m)                                 {}
+func exitThread(wait *atomic.Uint32)                 { throw(arosStub) }
+func osyield()                                       { throw(arosStub) }
+
+//go:nosplit
+func osyield_no_g() { osyield() }
+
+//
+// Semaphores, used by lock_sema.go and the note implementation.
+//
+
+func semacreate(mp *m)         { throw(arosStub) }
+func semasleep(ns int64) int   { throw(arosStub); return 0 }
+func semawakeup(mp *m)         { throw(arosStub) }
+
+//
+// Process exit and raw output. These go to dos.library, not to a file
+// descriptor: AROS has no fd table at this level.
+//
+
+func exit(e int32) { throw(arosStub) }
+
+//go:nosplit
+func write1(fd uintptr, buf unsafe.Pointer, n int32) int32 { return -1 }
+
+func crash() { throw(arosStub) }
+
+//
+// Memory. mem_sbrk.go drives this; on AROS the primitive is AllocMem, which
+// has no brk-style contiguous growth, so this is the piece most likely to need
+// a different shape from Plan 9's.
+//
+
+func sbrk(n uintptr) unsafe.Pointer { return nil }
diff --git a/src/runtime/signal_aros.go b/src/runtime/signal_aros.go
new file mode 100644
index 00000000..12eb0caa
--- /dev/null
+++ b/src/runtime/signal_aros.go
@@ -0,0 +1,33 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build aros
+
+// Signal handling for AROS. Stubs -- see the header of os_aros.go for why.
+//
+// AROS does not deliver Unix signals. Exec has its own signal bits per task,
+// and traps arrive through tc_TrapCode rather than through a handler table, so
+// this layer will end up closer to Plan 9's note mechanism than to signal_unix.go.
+// Preemption in particular has no obvious counterpart: preemptMSupported is
+// false for now, which costs only preemption latency, not correctness.
+
+package runtime
+
+func initsig(preinit bool)   {}
+func clearSignalHandlers()   {}
+func sigblock(exiting bool)  {}
+func sigsave(p *sigset)      {}
+func msigrestore(sigmask sigset) {}
+func sigenable(sig uint32)   {}
+func sigdisable(sig uint32)  {}
+func sigignore(sig uint32)   {}
+
+func signame(sig uint32) string { return "" }
+
+func setProcessCPUProfiler(hz int32) {}
+func setThreadCPUProfiler(hz int32)  {}
+
+const preemptMSupported = false
+
+func preemptM(mp *m) { throw("aros: preemptM not supported") }
