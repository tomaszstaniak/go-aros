+// -- file descriptors, for package syscall ----------------------------------
+//
+// AROS's C library keeps a POSIX-shaped fd table over dos.library handles,
+// which is all package syscall needs for files and the console. Each helper
+// returns -errno on failure, so the Go side gets a syscall.Errno without a
+// second call.
+
+#include <fcntl.h>
+#include <sys/types.h>
+
+struct aros_read_args { uintptr fd; void *buf; int32_t n; int32_t ret; };
+
+void
+x_cgo_aros_read(struct aros_read_args *a)
+{
+	int r = read((int)a->fd, a->buf, (size_t)a->n);
+	a->ret = r < 0 ? -errno : r;
+}
+
+struct aros_open_args { const char *path; int32_t flags; uint32_t mode; int32_t ret; };
+
+void
+x_cgo_aros_open(struct aros_open_args *a)
+{
+	int r = open(a->path, a->flags, a->mode);
+	a->ret = r < 0 ? -errno : r;
+}
+
+struct aros_close_args { uintptr fd; int32_t ret; };
+
+void
+x_cgo_aros_close(struct aros_close_args *a)
+{
+	int r = close((int)a->fd);
+	a->ret = r < 0 ? -errno : r;
+}
+
+struct aros_lseek_args { uintptr fd; int64_t off; int32_t whence; int64_t ret; };
+
+void
+x_cgo_aros_lseek(struct aros_lseek_args *a)
+{
+	off_t r = lseek((int)a->fd, (off_t)a->off, a->whence);
+	a->ret = r < 0 ? -(int64_t)errno : (int64_t)r;
+}
+
