+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build aros
+
+package runtime
+
+import "unsafe"
+
+// Package syscall's way into the C library. AROS has no syscalls, so these
+// are the same asmcgocall crossings the runtime uses for itself, wrapped in
+// entersyscall/exitsyscall so a blocking read hands its P to another M --
+// exactly what syscall_syscall does on Darwin.
+
+//go:linkname _cgo_aros_read _cgo_aros_read
+//go:linkname _cgo_aros_open _cgo_aros_open
+//go:linkname _cgo_aros_close _cgo_aros_close
+//go:linkname _cgo_aros_lseek _cgo_aros_lseek
+var (
+	_cgo_aros_read  unsafe.Pointer
+	_cgo_aros_open  unsafe.Pointer
+	_cgo_aros_close unsafe.Pointer
+	_cgo_aros_lseek unsafe.Pointer
+)
+
+//go:linkname syscall_aros_write syscall.aros_write
+//go:nosplit
+func syscall_aros_write(fd uintptr, p unsafe.Pointer, n int32) int32 {
+	a := struct {
+		fd  uintptr
+		buf unsafe.Pointer
+		n   int32
+		ret int32
+	}{fd, p, n, 0}
+	entersyscall()
+	asmcgocall(_cgo_aros_write, unsafe.Pointer(&a))
+	exitsyscall()
+	return a.ret
+}
+
+//go:linkname syscall_aros_read syscall.aros_read
+//go:nosplit
+func syscall_aros_read(fd uintptr, p unsafe.Pointer, n int32) int32 {
+	a := struct {
+		fd  uintptr
+		buf unsafe.Pointer
+		n   int32
+		ret int32
+	}{fd, p, n, 0}
+	entersyscall()
+	asmcgocall(_cgo_aros_read, unsafe.Pointer(&a))
+	exitsyscall()
+	return a.ret
+}
+
+//go:linkname syscall_aros_open syscall.aros_open
+//go:nosplit
+func syscall_aros_open(path unsafe.Pointer, flags int32, mode uint32) int32 {
+	a := struct {
+		path  unsafe.Pointer
+		flags int32
+		mode  uint32
+		ret   int32
+	}{path, flags, mode, 0}
+	entersyscall()
+	asmcgocall(_cgo_aros_open, unsafe.Pointer(&a))
+	exitsyscall()
+	return a.ret
+}
+
+//go:linkname syscall_aros_close syscall.aros_close
+//go:nosplit
+func syscall_aros_close(fd uintptr) int32 {
+	a := struct {
+		fd  uintptr
+		ret int32
+	}{fd, 0}
+	entersyscall()
+	asmcgocall(_cgo_aros_close, unsafe.Pointer(&a))
+	exitsyscall()
+	return a.ret
+}
+
+//go:linkname syscall_aros_lseek syscall.aros_lseek
+//go:nosplit
+func syscall_aros_lseek(fd uintptr, off int64, whence int32) int64 {
+	a := struct {
+		fd     uintptr
+		off    int64
+		whence int32
+		ret    int64
+	}{fd, off, whence, 0}
+	entersyscall()
+	asmcgocall(_cgo_aros_lseek, unsafe.Pointer(&a))
+	exitsyscall()
+	return a.ret
+}
+
+//go:linkname syscall_aros_exit syscall.aros_exit
+func syscall_aros_exit(code int32) {
+	exit(code)
+}
