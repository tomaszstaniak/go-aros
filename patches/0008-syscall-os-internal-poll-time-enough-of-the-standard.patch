+// license that can be found in the LICENSE file.
+
+//go:build aros
+
+package syscall
+
+import "errors"
+
+// Open flags. AROS's C library uses the common values.
+const (
+	O_RDONLY   = 0x0
+	O_WRONLY   = 0x1
+	O_RDWR     = 0x2
+	O_APPEND   = 0x400
+	O_CREAT    = 0x40
+	O_EXCL     = 0x80
+	O_TRUNC    = 0x200
+	O_NONBLOCK = 0x800
+	O_SYNC     = 0x101000
+	O_CLOEXEC  = 0x80000
+)
+
+// Errno values, common Unix numbering. Only the ones package os and its
+// callers compare against are listed by name; anything else prints as
+// "errno N" until the AROS table is checked against errno.h.
+const (
+	EPERM        = Errno(1)
+	ENOENT       = Errno(2)
+	EINTR        = Errno(4)
+	EIO          = Errno(5)
+	EBADF        = Errno(9)
+	EAGAIN       = Errno(11)
+	EWOULDBLOCK  = Errno(11)
+	ENOMEM       = Errno(12)
+	EACCES       = Errno(13)
+	EEXIST       = Errno(17)
+	ENOTDIR      = Errno(20)
+	EISDIR       = Errno(21)
+	EINVAL       = Errno(22)
+	ENFILE       = Errno(23)
+	EMFILE       = Errno(24)
+	ENOSPC       = Errno(28)
+	ESPIPE       = Errno(29)
+	EROFS        = Errno(30)
+	EPIPE        = Errno(32)
+	ERANGE       = Errno(34)
+	ENAMETOOLONG = Errno(36)
+	ENOSYS       = Errno(38)
+	ENOTEMPTY    = Errno(39)
+	ENOTSUP      = Errno(95)
+	EOPNOTSUPP   = Errno(95)
+	ETIMEDOUT    = Errno(110)
+)
+
+var errorTable = [...]string{
+	1:   "operation not permitted",
+	2:   "no such file or directory",
+	4:   "interrupted system call",
+	5:   "input/output error",
+	9:   "bad file descriptor",
+	11:  "resource temporarily unavailable",
+	12:  "cannot allocate memory",
+	13:  "permission denied",
+	17:  "file exists",
+	20:  "not a directory",
+	21:  "is a directory",
+	22:  "invalid argument",
+	23:  "too many open files in system",
+	24:  "too many open files",
+	28:  "no space left on device",
+	29:  "illegal seek",
+	30:  "read-only file system",
+	32:  "broken pipe",
+	34:  "numerical result out of range",
+	36:  "file name too long",
+	38:  "function not implemented",
+	39:  "directory not empty",
+	95:  "operation not supported",
+	110: "connection timed out",
+}
+
+var errorspkgUnsupported = errors_ErrUnsupported()
+
+func errors_ErrUnsupported() error { return errorsErrUnsupported }
+
+var errorsErrUnsupported = errorsNew("unsupported operation")
+
+func errorsNew(s string) error { return errors.New(s) }
diff --git a/src/syscall/syscall_aros.go b/src/syscall/syscall_aros.go
new file mode 100644
index 00000000..93033eb4
--- /dev/null
+++ b/src/syscall/syscall_aros.go
@@ -0,0 +1,215 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build aros
+
+// AROS system calls, first cut: files and the console. AROS has no syscalls;
+// each of these reaches the C library through a function the runtime exports
+// (runtime/syscall_aros.go), wrapped in entersyscall/exitsyscall. Errors come
+// back as -errno, the C library's own numbers.
+//
+// Everything a fmt program does not need is ENOSYS here, marked as such, so
+// that package os compiles. Filling those in is the work that turns this from
+// a bringup port into a usable one.
+
+package syscall
+
+import (
+	"internal/oserror"
+	"runtime"
+	"unsafe"
+)
+
+const ImplementsGetwd = false
+const bitSize16 = 2
+
+// An Errno is the C library's errno. AROS's numbering follows the common
+// Unix values for everything a program is likely to see.
+type Errno uintptr
+
+func (e Errno) Error() string {
+	if 0 <= int(e) && int(e) < len(errorTable) {
+		s := errorTable[e]
+		if s != "" {
+			return s
+		}
+	}
+	return "errno " + itoa(int(e))
+}
+
+func (e Errno) Is(target error) bool {
+	switch target {
+	case oserror.ErrPermission:
+		return e == EACCES || e == EPERM
+	case oserror.ErrExist:
+		return e == EEXIST || e == ENOTEMPTY
+	case oserror.ErrNotExist:
+		return e == ENOENT
+	case errorspkgUnsupported:
+		return e == ENOSYS || e == ENOTSUP || e == EOPNOTSUPP
+	}
+	return false
+}
+
+func (e Errno) Temporary() bool {
+	return e == EINTR || e == EMFILE || e == ENFILE || e.Timeout()
+}
+
+func (e Errno) Timeout() bool {
+	return e == EAGAIN || e == EWOULDBLOCK || e == ETIMEDOUT
+}
+
+func itoa(v int) string {
+	if v == 0 {
+		return "0"
+	}
+	neg := v < 0
+	if neg {
+		v = -v
+	}
+	var b [20]byte
+	i := len(b)
+	for v > 0 {
+		i--
+		b[i] = byte('0' + v%10)
+		v /= 10
+	}
+	if neg {
+		i--
+		b[i] = '-'
+	}
+	return string(b[i:])
+}
+
+// A Signal is a number describing a process signal. AROS has no Unix
+// signals; the type exists so package os compiles.
+type Signal int
+
+func (s Signal) Signal() {}
+func (s Signal) String() string { return "signal " + itoa(int(s)) }
+
+const (
+	SIGINT  = Signal(2)
+	SIGKILL = Signal(9)
+	SIGTERM = Signal(15)
+)
+
+var (
+	Stdin  = 0
+	Stdout = 1
+	Stderr = 2
+)
+
+// -- provided by the runtime ------------------------------------------------
+
+func aros_write(fd uintptr, p unsafe.Pointer, n int32) int32
+func aros_read(fd uintptr, p unsafe.Pointer, n int32) int32
+func aros_open(path unsafe.Pointer, flags int32, mode uint32) int32
+func aros_close(fd uintptr) int32
+func aros_lseek(fd uintptr, off int64, whence int32) int64
+func aros_exit(code int32)
+
+func errnoErr(r int32) error {
+	if r < 0 {
+		return Errno(-r)
+	}
+	return nil
+}
+
+func Read(fd int, p []byte) (n int, err error) {
+	if len(p) == 0 {
+		return 0, nil
+	}
+	r := aros_read(uintptr(fd), unsafe.Pointer(&p[0]), int32(len(p)))
+	if r < 0 {
+		return 0, Errno(-r)
+	}
+	return int(r), nil
+}
+
+func Write(fd int, p []byte) (n int, err error) {
+	if len(p) == 0 {
+		return 0, nil
+	}
+	r := aros_write(uintptr(fd), unsafe.Pointer(&p[0]), int32(len(p)))
+	if r < 0 {
+		return 0, Errno(-r)
+	}
+	return int(r), nil
+}
+
+func Open(path string, mode int, perm uint32) (fd int, err error) {
+	p, err := BytePtrFromString(path)
+	if err != nil {
+		return -1, err
+	}
+	r := aros_open(unsafe.Pointer(p), int32(mode), perm)
+	runtime.KeepAlive(p)
+	if r < 0 {
+		return -1, Errno(-r)
+	}
+	return int(r), nil
+}
+
+func Close(fd int) (err error) {
+	return errnoErr(aros_close(uintptr(fd)))
+}
+
+func Seek(fd int, offset int64, whence int) (newoffset int64, err error) {
+	r := aros_lseek(uintptr(fd), offset, int32(whence))
+	if r < 0 {
+		return 0, Errno(-r)
+	}
+	return r, nil
+}
+
+// Process identity. AROS tasks have no numeric pid in the Unix sense; these
+// return fixed values so os compiles and behaves sanely.
+func Getpid() int    { return 1 }
+func Getppid() int   { return 0 }
+func Getuid() int    { return 0 }
