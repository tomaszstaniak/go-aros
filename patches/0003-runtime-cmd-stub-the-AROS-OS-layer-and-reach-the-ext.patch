diff --git a/src/cmd/go/internal/work/exec.go b/src/cmd/go/internal/work/exec.go
index 8dcf3245..0e09bc61 100644
--- a/src/cmd/go/internal/work/exec.go
+++ b/src/cmd/go/internal/work/exec.go
@@ -2475,13 +2475,20 @@ func (b *Builder) compilerCmd(compiler []string, incdir, workdir string) []strin
 
 	// Definitely want -fPIC but on Windows gcc complains
 	// "-fPIC ignored for target (all code is position independent)"
-	if cfg.Goos != "windows" {
+	if cfg.Goos != "windows" && cfg.Goos != "aros" {
 		a = append(a, "-fPIC")
 	}
 	a = append(a, b.gccArchArgs()...)
-	// gcc-4.5 and beyond require explicit "-pthread" flag
-	// for multithreading with pthread library.
-	if cfg.BuildContext.CgoEnabled {
+	if cfg.Goos == "aros" {
+		// AROS executables are ET_REL and everything in the system is built
+		// this way; -fPIC is wrong here. The AROS gcc driver also does not
+		// accept -pthread -- libpthread.a is named explicitly instead, and has
+		// to be linked in a group with -lgcc because the emulated-TLS helper
+		// lives in libgcc.
+		a = append(a, "-mcmodel=large", "-mno-red-zone")
+	} else if cfg.BuildContext.CgoEnabled {
+		// gcc-4.5 and beyond require explicit "-pthread" flag
+		// for multithreading with pthread library.
 		a = append(a, "-pthread")
 	}
 
