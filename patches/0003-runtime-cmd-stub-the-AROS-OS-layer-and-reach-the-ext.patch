From 9072904676ff0ac078a0ee9c38f9153c4f547a97 Mon Sep 17 00:00:00 2001
From: tomaszstaniak <nbw.designs@gmail.com>
Date: Wed, 2 Sep 2026 13:13:52 +0200
Subject: [PATCH 3/9] runtime, cmd: stub the AROS OS layer and reach the
 external linker

Stubs with correct signatures for the 37 OS-layer symbols, deliberately
throwing rather than working: the point is to compile and link a program
so the -linkmode=external question can be answered before the real
implementations are written, since a negative answer would change the
shape of the port.

lock_sema.go already supplies the note functions once aros is on its
build tag, so those stubs came straight back out.

Also: treat Haros as ELF in archinit and asmb2 so the linker writes a
relocatable object for the host linker, but keep R_TLS_LE resolved
internally -- g is reached through a pointer the kernel publishes in the
%gs block, not through ELF TLS, so handing that relocation to
x86_64-aros-gcc would ask it for something it cannot do. And drop -fPIC
and -pthread for GOOS=aros in cmd/go, adding -mcmodel=large
-mno-red-zone: AROS builds everything ET_REL and its gcc driver rejects
-pthread outright.

Everything now compiles, runtime/cgo included, and the linker reaches
ELF relocation emission before failing on a size mismatch.
---
 src/cmd/go/internal/work/exec.go   | 15 +++--
 src/cmd/link/internal/amd64/obj.go |  3 +-
 src/cmd/link/internal/ld/asmb.go   |  3 +-
 src/cmd/link/internal/ld/data.go   |  2 +-
 src/internal/goos/zgoos_aros.go    | 27 +++++++++
 src/runtime/os_aros.go             | 95 ++++++++++++++++++++++++++++++
 src/runtime/signal_aros.go         | 33 +++++++++++
 src/runtime/sigqueue_aros.go       | 17 ++++++
 src/runtime/time_aros.go           | 28 +++++++++
 9 files changed, 216 insertions(+), 7 deletions(-)
 create mode 100644 src/internal/goos/zgoos_aros.go
 create mode 100644 src/runtime/os_aros.go
 create mode 100644 src/runtime/signal_aros.go
 create mode 100644 src/runtime/sigqueue_aros.go
 create mode 100644 src/runtime/time_aros.go

diff --git a/src/cmd/go/internal/work/exec.go b/src/cmd/go/internal/work/exec.go
index 8dcf3245..0e09bc61 100644
--- a/src/cmd/go/internal/work/exec.go
+++ b/src/cmd/go/internal/work/exec.go
@@ -2475,13 +2475,20 @@ func (b *Builder) compilerCmd(compiler []string, incdir, workdir string) []strin
 
 	// Definitely want -fPIC but on Windows gcc complains
 	// "-fPIC ignored for target (all code is position independent)"
-	if cfg.Goos != "windows" {
+	if cfg.Goos != "windows" && cfg.Goos != "aros" {
 		a = append(a, "-fPIC")
 	}
 	a = append(a, b.gccArchArgs()...)
-	// gcc-4.5 and beyond require explicit "-pthread" flag
-	// for multithreading with pthread library.
-	if cfg.BuildContext.CgoEnabled {
+	if cfg.Goos == "aros" {
+		// AROS executables are ET_REL and everything in the system is built
+		// this way; -fPIC is wrong here. The AROS gcc driver also does not
+		// accept -pthread -- libpthread.a is named explicitly instead, and has
+		// to be linked in a group with -lgcc because the emulated-TLS helper
+		// lives in libgcc.
+		a = append(a, "-mcmodel=large", "-mno-red-zone")
+	} else if cfg.BuildContext.CgoEnabled {
+		// gcc-4.5 and beyond require explicit "-pthread" flag
+		// for multithreading with pthread library.
 		a = append(a, "-pthread")
 	}
 
