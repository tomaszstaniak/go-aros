+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build aros
+
+// The AROS runtime's operating-system layer, C side.
+//
+// AROS has no syscalls: everything is a library call through SysBase or the
+// C library, and both need a C stack and C calling convention. So the Go
+// runtime reaches these through asmcgocall, exactly the way it reaches
+// _cgo_thread_start, and each function takes one pointer to an argument block.
+// This makes runtime/cgo a hard dependency of the AROS runtime, which is
+// acceptable because an AROS executable is always externally linked anyway.
+
+#include <proto/exec.h>
+#include <exec/memory.h>
+#include <pthread.h>
+#include <sched.h>
+#include <time.h>
+#include <unistd.h>
+#include <stdlib.h>
+#include <errno.h>
+#include "libcgo.h"
+
+// -- raw output and exit --------------------------------------------------
+
+struct aros_write_args { uintptr fd; void *buf; int32_t n; int32_t ret; };
+
+void
+x_cgo_aros_write(struct aros_write_args *a)
+{
+	int r = write((int)a->fd, a->buf, (size_t)a->n);
+	a->ret = r < 0 ? -errno : r;
+}
+
+struct aros_exit_args { int32_t code; };
+
+void
+x_cgo_aros_exit(struct aros_exit_args *a)
+{
+	exit(a->code);
+}
+
+// -- time -------------------------------------------------------------------
+
+struct aros_walltime_args { int64_t sec; int32_t nsec; };
+
+void
+x_cgo_aros_walltime(struct aros_walltime_args *a)
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_REALTIME, &ts);
+	a->sec = ts.tv_sec;
+	a->nsec = (int32_t)ts.tv_nsec;
+}
+
+struct aros_nanotime_args { int64_t ns; };
+
+void
+x_cgo_aros_nanotime(struct aros_nanotime_args *a)
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	a->ns = (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
+}
+
+struct aros_usleep_args { uint32_t us; };
+
+void
+x_cgo_aros_usleep(struct aros_usleep_args *a)
+{
+	struct timespec ts;
+	ts.tv_sec = a->us / 1000000;
+	ts.tv_nsec = (long)(a->us % 1000000) * 1000;
+	nanosleep(&ts, NULL);
+}
+
+void
+x_cgo_aros_yield(void *unused)
+{
+	sched_yield();
+}
+
+// -- memory -----------------------------------------------------------------
+
+// The Go heap on AROS is one arena from AllocMem, handed out by sbrk in
+// runtime/os_aros.go. mem_sbrk.go requires sbrk results to be contiguous
+// with the current break, which AllocMem cannot promise call by call, so the
+// whole reservation is taken up front. MEMF_CLEAR because sbrk memory is
+// assumed zeroed.
+struct aros_allocmem_args { uintptr size; void *ret; };
+
+void
+x_cgo_aros_allocmem(struct aros_allocmem_args *a)
+{
+	a->ret = AllocMem(a->size, MEMF_ANY | MEMF_CLEAR);
+}
+
+// -- per-M semaphore, for lock_sema.go ---------------------------------------
+
+typedef struct {
+	pthread_mutex_t mu;
+	pthread_cond_t  cv;
+	int             count;
+} aros_sema;
+
+struct aros_sema_args { void *sema; int64_t ns; int32_t ret; };
+
+void
+x_cgo_aros_semacreate(struct aros_sema_args *a)
+{
+	aros_sema *s = malloc(sizeof *s);
+	if (s == NULL) {
+		fatalf("aros: out of memory creating semaphore");
+	}
+	pthread_mutex_init(&s->mu, NULL);
+	pthread_cond_init(&s->cv, NULL);
+	s->count = 0;
+	a->sema = s;
+}
+
+void
+x_cgo_aros_semasleep(struct aros_sema_args *a)
+{
+	aros_sema *s = a->sema;
+	pthread_mutex_lock(&s->mu);
+	if (a->ns < 0) {
+		while (s->count == 0) {
+			pthread_cond_wait(&s->cv, &s->mu);
+		}
+	} else {
+		struct timespec dl;
+		clock_gettime(CLOCK_REALTIME, &dl);
+		dl.tv_sec  += a->ns / 1000000000LL;
+		dl.tv_nsec += a->ns % 1000000000LL;
+		if (dl.tv_nsec >= 1000000000L) {
+			dl.tv_sec++;
+			dl.tv_nsec -= 1000000000L;
+		}
+		while (s->count == 0) {
+			if (pthread_cond_timedwait(&s->cv, &s->mu, &dl) == ETIMEDOUT) {
+				break;
+			}
+		}
+	}
+	if (s->count > 0) {
+		s->count--;
+		a->ret = 0;
+	} else {
+		a->ret = -1;
+	}
+	pthread_mutex_unlock(&s->mu);
+}
+
+void
+x_cgo_aros_semawakeup(struct aros_sema_args *a)
+{
+	aros_sema *s = a->sema;
+	pthread_mutex_lock(&s->mu);
+	s->count++;
+	pthread_cond_signal(&s->cv);
+	pthread_mutex_unlock(&s->mu);
+}
