+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build aros
+
+package os
+
+import (
+	"syscall"
+	"time"
+)
+
+// The only signal values guaranteed to be present in the os package on all
+// systems are Interrupt and Kill.
+var (
+	Interrupt Signal = syscall.SIGINT
+	Kill      Signal = syscall.SIGKILL
+)
+
+func startProcess(name string, argv []string, attr *ProcAttr) (p *Process, err error) {
+	return nil, &PathError{Op: "fork/exec", Path: name, Err: syscall.ENOSYS}
+}
+
+func (p *Process) signal(sig Signal) error { return syscall.ENOSYS }
+func (p *Process) kill() error             { return syscall.ENOSYS }
+
+func (p *Process) wait() (ps *ProcessState, err error) {
+	return nil, syscall.ENOSYS
+}
+
+func (p *Process) withHandle(_ func(handle uintptr)) error { return syscall.ENOSYS }
+
+func findProcess(pid int) (p *Process, err error) {
+	return newPIDProcess(pid), nil
+}
+
+// ProcessState stores information about a process, as reported by Wait.
+type ProcessState struct {
+	pid    int
+	status syscall.WaitStatus
+	rusage *syscall.Rusage
+}
+
+func (p *ProcessState) Pid() int                  { return p.pid }
+func (p *ProcessState) exited() bool              { return p.status.Exited() }
+func (p *ProcessState) success() bool             { return p.status.ExitStatus() == 0 }
+func (p *ProcessState) sys() any                  { return p.status }
+func (p *ProcessState) sysUsage() any             { return p.rusage }
+func (p *ProcessState) userTime() time.Duration   { return 0 }
+func (p *ProcessState) systemTime() time.Duration { return 0 }
+func (p *ProcessState) String() string {
+	if p == nil {
+		return "<nil>"
+	}
+	return "exit status " + itoa(p.status.ExitStatus())
+}
+func (p *ProcessState) ExitCode() int {
+	if p == nil {
+		return -1
+	}
+	return p.status.ExitStatus()
+}
+
+func itoa(v int) string {
+	if v == 0 {
+		return "0"
+	}
+	neg := v < 0
+	if neg {
+		v = -v
+	}
+	var b [20]byte
+	i := len(b)
+	for v > 0 {
+		i--
+		b[i] = byte('0' + v%10)
+		v /= 10
+	}
+	if neg {
+		i--
+		b[i] = '-'
+	}
+	return string(b[i:])
+}
