diff --git a/src/os/file_aros.go b/src/os/file_aros.go
new file mode 100644
index 00000000..4723157f
--- /dev/null
+++ b/src/os/file_aros.go
@@ -0,0 +1,277 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build aros
+
+package os
+
+import (
+	"internal/poll"
+	"io"
+	"io/fs"
+	"runtime"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"time"
+)
+
+// fixLongPath is a noop on AROS.
+func fixLongPath(path string) string { return path }
+
+// file is the real representation of *File. Same as Plan 9's: the descriptor
+// is kept here and I/O goes straight through syscall; internal/poll is used
+// only for its reference-counting mutex.
+type file struct {
+	fdmu       poll.FDMutex
+	sysfd      int
+	name       string
+	dirinfo    atomic.Pointer[dirInfo] // nil unless directory being read
+	appendMode bool                    // whether file is opened for appending
+}
+
+func (f *File) fd() uintptr {
+	if f == nil {
+		return ^(uintptr(0))
+	}
+	return uintptr(f.sysfd)
+}
+
+func newFileFromNewFile(fd uintptr, name string) *File {
+	fdi := int(fd)
+	if fdi < 0 {
+		return nil
+	}
+	f := &File{&file{sysfd: fdi, name: name}}
+	runtime.SetFinalizer(f.file, (*file).close)
+	return f
+}
+
+// Auxiliary information if the File describes a directory. Unused until
+// readdir exists.
+type dirInfo struct {
+	mu sync.Mutex
+}
+
+func epipecheck(file *File, e error) {}
+
+// DevNull is the name of the operating system's "null device".
+const DevNull = "NIL:"
+
+func syscallMode(i FileMode) (o uint32) { return uint32(i.Perm()) }
+
+func openFileNolog(name string, flag int, perm FileMode) (*File, error) {
+	fd, e := syscall.Open(name, flag, syscallMode(perm))
+	if e != nil {
+		return nil, &PathError{Op: "open", Path: name, Err: e}
+	}
+	f := newFileFromNewFile(uintptr(fd), name)
+	if flag&O_APPEND != 0 {
+		f.appendMode = true
+	}
+	return f, nil
+}
+
+func openDirNolog(name string) (*File, error) {
+	return nil, &PathError{Op: "open", Path: name, Err: syscall.ENOSYS}
+}
+
+func (f *File) Close() error {
+	if f == nil {
+		return ErrInvalid
+	}
+	return f.file.close()
+}
+
+func (file *file) close() error {
+	if file == nil {
+		return syscall.EINVAL
+	}
+	if !file.fdmu.IncrefAndClose() {
+		return &PathError{Op: "close", Path: file.name, Err: ErrClosed}
+	}
+	var err error
+	if e := syscall.Close(file.sysfd); e != nil {
+		err = &PathError{Op: "close", Path: file.name, Err: e}
+	}
+	file.sysfd = -1
+	runtime.SetFinalizer(file, nil)
+	return err
+}
+
+func (file *file) destroy() error {
+	var err error
+	if e := syscall.Close(file.sysfd); e != nil {
+		err = &PathError{Op: "close", Path: file.name, Err: e}
+	}
+	file.sysfd = -1
+	runtime.SetFinalizer(file, nil)
+	return err
+}
+
+func (f *File) Stat() (FileInfo, error) {
+	if f == nil {
+		return nil, ErrInvalid
+	}
+	return nil, &PathError{Op: "stat", Path: f.name, Err: syscall.ENOSYS}
+}
+
+func (f *File) Truncate(size int64) error {
+	return &PathError{Op: "truncate", Path: f.name, Err: syscall.ENOSYS}
+}
+
+func (f *File) chmod(mode FileMode) error {
+	return &PathError{Op: "chmod", Path: f.name, Err: syscall.ENOSYS}
+}
+
+func (f *File) Sync() error { return nil }
+
+func (f *File) read(b []byte) (n int, err error) {
+	n, e := syscall.Read(f.sysfd, b)
+	if n < 0 {
+		n = 0
+	}
+	return n, e
+}
+
+func (f *File) pread(b []byte, off int64) (n int, err error) {
+	if _, e := syscall.Seek(f.sysfd, off, io.SeekStart); e != nil {
+		return 0, e
+	}
+	return f.read(b)
+}
+
+func (f *File) write(b []byte) (n int, err error) {
+	for {
+		m, e := syscall.Write(f.sysfd, b)
+		if m < 0 {
+			m = 0
+		}
+		n += m
+		if e != nil {
+			return n, e
+		}
+		if m >= len(b) {
+			return n, nil
+		}
+		b = b[m:]
+	}
+}
+
+func (f *File) pwrite(b []byte, off int64) (n int, err error) {
+	if _, e := syscall.Seek(f.sysfd, off, io.SeekStart); e != nil {
+		return 0, e
+	}
+	return f.write(b)
+}
+
+func (f *File) seek(offset int64, whence int) (ret int64, err error) {
+	f.dirinfo.Store(nil)
+	return syscall.Seek(f.sysfd, offset, whence)
+}
+
+func Truncate(name string, size int64) error {
+	return &PathError{Op: "truncate", Path: name, Err: syscall.ENOSYS}
+}
+
+func Remove(name string) error {
+	return &PathError{Op: "remove", Path: name, Err: syscall.ENOSYS}
+}
+
+func rename(oldname, newname string) error {
+	return &LinkError{"rename", oldname, newname, syscall.ENOSYS}
+}
+
+func chmod(name string, mode FileMode) error {
+	return &PathError{Op: "chmod", Path: name, Err: syscall.ENOSYS}
+}
+
+func Chtimes(name string, atime time.Time, mtime time.Time) error {
+	return &PathError{Op: "chtimes", Path: name, Err: syscall.ENOSYS}
+}
+
+func Pipe() (r *File, w *File, err error) {
+	return nil, nil, NewSyscallError("pipe", syscall.ENOSYS)
+}
+
+func Link(oldname, newname string) error {
+	return &LinkError{"link", oldname, newname, syscall.ENOSYS}
+}
+
+func Symlink(oldname, newname string) error {
+	return &LinkError{"symlink", oldname, newname, syscall.ENOSYS}
+}
+
+func readlink(name string) (string, error) {
+	return "", &PathError{Op: "readlink", Path: name, Err: syscall.ENOSYS}
+}
+
+func Chown(name string, uid, gid int) error {
+	return &PathError{Op: "chown", Path: name, Err: syscall.ENOSYS}
+}
+
+func Lchown(name string, uid, gid int) error {
+	return &PathError{Op: "lchown", Path: name, Err: syscall.ENOSYS}
+}
+
+func (f *File) Chown(uid, gid int) error {
+	return &PathError{Op: "chown", Path: f.name, Err: syscall.ENOSYS}
+}
+
+func tempDir() string {
+	dir := Getenv("TMPDIR")
+	if dir == "" {
+		dir = "T:"
+	}
+	return dir
+}
+
+func (f *File) Chdir() error {
+	return &PathError{Op: "chdir", Path: f.name, Err: syscall.ENOSYS}
+}
+
+func (f *File) setDeadline(time.Time) error {
+	if err := f.checkValid("SetDeadline"); err != nil {
+		return err
+	}
+	return poll.ErrNoDeadline
+}
+
+func (f *File) setReadDeadline(time.Time) error {
+	if err := f.checkValid("SetReadDeadline"); err != nil {
+		return err
+	}
+	return poll.ErrNoDeadline
+}
+
+func (f *File) setWriteDeadline(time.Time) error {
+	if err := f.checkValid("SetWriteDeadline"); err != nil {
+		return err
+	}
+	return poll.ErrNoDeadline
+}
+
+func (f *File) checkValid(op string) error {
+	if f == nil {
+		return ErrInvalid
+	}
+	if f.sysfd == -1 {
+		return &PathError{Op: op, Path: f.name, Err: ErrClosed}
+	}
+	return nil
+}
+
+type rawConn struct{}
+
+func (c *rawConn) Control(f func(uintptr)) error  { return syscall.ENOSYS }
+func (c *rawConn) Read(f func(uintptr) bool) error { return syscall.ENOSYS }
+func (c *rawConn) Write(f func(uintptr) bool) error { return syscall.ENOSYS }
+
+func newRawConn(file *File) (*rawConn, error) { return nil, syscall.ENOSYS }
+
+func ignoringEINTR(fn func() error) error { return fn() }
+
+func ignoringEINTR2[T any](fn func() (T, error)) (T, error) { return fn() }
+
+var _ = fs.ErrInvalid
